  "familles": [
    { "id": "solanacees", "nom": "Solanacées", "nomLatin": "Solanaceae", "critere": "Fleur à 5 pétales soudés en étoile, fruit en baie (ou capsule pour la pomme de terre), étamines jaunes groupées au centre", "imageAnatomie": "images/familles/solanacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Solanaceae" },
    { "id": "cucurbitacees", "nom": "Cucurbitacées", "nomLatin": "Cucurbitaceae", "critere": "Plante grimpante/rampante à vrilles, grandes fleurs jaunes mâles et femelles séparées, gros fruit charnu (baie-péponide)", "imageAnatomie": "images/familles/cucurbitacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Cucurbitaceae" },
    { "id": "brassicacees", "nom": "Brassicacées", "nomLatin": "Brassicaceae", "critere": "4 pétales disposés en croix, 6 étamines (4 longues + 2 courtes), fruit en silique ou silicule", "imageAnatomie": "images/familles/brassicacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Brassicaceae" },
    { "id": "fabacees", "nom": "Fabacées", "nomLatin": "Fabaceae", "critere": "Fleur papilionacée (forme de papillon), fruit en gousse, feuilles souvent composées, racines nodulées (fixation d'azote)", "imageAnatomie": "images/familles/fabacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Fabaceae" },
    { "id": "alliacees", "nom": "Alliacées", "nomLatin": "Allioideae", "critere": "Bulbe, feuilles engainantes, fleurs regroupées en ombelle sphérique, odeur soufrée caractéristique", "imageAnatomie": "images/familles/alliacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Amaryllidaceae" },
    { "id": "apiacees", "nom": "Apiacées", "nomLatin": "Apiaceae", "critere": "Fleurs minuscules en ombelle plate, tige souvent creuse et cannelée, feuillage très découpé et aromatique", "imageAnatomie": "images/familles/apiacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Apiaceae" },
    { "id": "asteracees", "nom": "Astéracées", "nomLatin": "Asteraceae", "critere": "Inflorescence en capitule (fausse fleur faite de nombreux petits fleurons), souvent latex blanc dans la tige", "imageAnatomie": "images/familles/asteracees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Asteraceae" },
    { "id": "chenopodiacees", "nom": "Chénopodiacées", "nomLatin": "Chenopodioideae", "critere": "Fleurs minuscules verdâtres sans pétales, feuilles souvent charnues, tige parfois rougeâtre", "imageAnatomie": "images/familles/chenopodiacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Amaranthaceae" },
    { "id": "poacees", "nom": "Poacées", "nomLatin": "Poaceae", "critere": "Tige creuse à nœuds (chaume), feuilles engainantes à nervures parallèles, fleurs minuscules groupées en épillets sans pétales visibles", "imageAnatomie": "images/familles/poacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Poaceae" },
    { "id": "rosacees", "nom": "Rosacées", "nomLatin": "Rosaceae", "critere": "Fleur à 5 pétales libres disposés en rosace, nombreuses étamines, réceptacle en coupe (hypanthe) ; fruits très divers : drupe, pomme, akène, gousse d'akènes (fraise), drupéoles (framboise) — jamais de gousse", "imageAnatomie": "images/familles/rosacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Rosaceae" },
    { "id": "convolvulacees", "nom": "Convolvulacées", "nomLatin": "Convolvulaceae", "critere": "Fleur en entonnoir à corolle soudée, plante souvent grimpante ou rampante à tige volubile, latex blanc parfois présent", "imageAnatomie": "images/familles/convolvulacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Convolvulaceae" },
    { "id": "asparagacees", "nom": "Asparagacées", "nomLatin": "Asparagaceae", "critere": "Jeunes pousses (turions) issues d'un rhizome, tige qui se ramifie ensuite en fines écailles, fleurs discrètes en clochette", "imageAnatomie": "images/familles/asparagacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Asparagaceae" },
    { "id": "polygonacees", "nom": "Polygonacées", "nomLatin": "Polygonaceae", "critere": "Tige noueuse portant une gaine membraneuse (ochréa) à chaque nœud, feuillage souvent acide (oxalates), fleurs minuscules en grappes", "imageAnatomie": "images/familles/polygonacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Polygonaceae" },
    { "id": "lamiacees", "nom": "Lamiacées", "nomLatin": "Lamiaceae", "critere": "Tige quadrangulaire (section carrée), feuilles opposées aromatiques, fleur « labiée » à 2 lèvres, fruits en 4 akènes", "imageAnatomie": "images/familles/lamiacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Lamiaceae" },
    { "id": "boraginacees", "nom": "Boraginacées", "nomLatin": "Boraginaceae", "critere": "Poils rudes au toucher, fleurs en cyme unilatérale qui se déroule comme une queue de scorpion, corolle à 5 lobes souvent bleue", "imageAnatomie": "images/familles/boraginacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Boraginaceae" },
    { "id": "malvacees", "nom": "Malvacées", "nomLatin": "Malvaceae", "critere": "Fleur à 5 pétales avec nombreuses étamines soudées en colonne centrale, souvent calice secondaire sous la fleur, mucilages", "imageAnatomie": "images/familles/malvacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Malvaceae" },
    { "id": "portulacacees", "nom": "Portulacacées", "nomLatin": "Portulacaceae", "critere": "Plante charnue et luisante aux feuilles épaisses, fleurs à 2 sépales et 5 pétales jaunes, capsule en petit cône", "imageAnatomie": "images/familles/portulacacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Portulacaceae" },
    { "id": "tropaeolacees", "nom": "Tropéolacées", "nomLatin": "Tropaeolaceae", "critere": "Fleur zygomorphe à éperon nectarifère porté par un sépale, 5 pétales libres (2 plus petits à l'avant), 8 étamines, feuilles en écusson de couleur glauque", "imageAnatomie": "images/familles/tropaeolacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Tropaeolaceae" },
    { "id": "caprifoliacees", "nom": "Caprifoliacées", "nomLatin": "Caprifoliaceae", "critere": "Fleurs petites à corolle soudée (chèvrefeuille) — mais dans cette famille au sens large : la mâche forme une rosette de feuilles et des petites fleurs en cyme avec un fruit indéhiscent", "imageAnatomie": "images/familles/caprifoliacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Caprifoliaceae" },
    { "id": "vitacees", "nom": "Vitacées", "nomLatin": "Vitaceae", "critere": "Liane à vrilles opposées aux feuilles, nœuds renflés, fleurs minuscules en grappes, baie juteuse", "imageAnatomie": "images/familles/vitacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Vitaceae" },
    { "id": "actinidiacees", "nom": "Actinidiacées", "nomLatin": "Actinidiaceae", "critere": "Liane ligneuse, feuilles alternes, fleurs blanches à 5 pétales avec nombreuses étamines, baie à pépins fins et durs", "imageAnatomie": "images/familles/actinidiacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Actinidiaceae" },
    { "id": "moracees", "nom": "Moracées", "nomLatin": "Moraceae", "critere": "Latex blanc à la coupe, feuilles alternes souvent lobées, fleurs minuscules groupées dans un réceptacle charnu (sycone = figue)", "imageAnatomie": "images/familles/moracees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Moraceae" },
    { "id": "grossulariacees", "nom": "Grossulariacées", "nomLatin": "Grossulariaceae", "critere": "Arbuste souvent épineux, feuilles palmatilobées à 3-5 lobes, petites fleurs en grappe retombante, baie translucide surmontée du calice (ovaire infère)", "imageAnatomie": "images/familles/grossulariacees-anatomie.jpg", "sourceAnatomie": "https://fr.wikipedia.org/wiki/Grossulariaceae" }
